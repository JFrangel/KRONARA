# Kronara development configuration. Copy to .env and fill only the providers you use.
KRONARA_ENV=development
KRONARA_DATA_DIR=.kronara
KRONARA_LOG_LEVEL=info
KRONARA_MAX_DAILY_COST_USD=5.00
KRONARA_MAX_RESEARCH_COST_USD=1.00

# Model providers
KRONARA_QWEN_BASE_URL=https://openrouter.ai/api/v1
KRONARA_QWEN_API_KEY=
KRONARA_QWEN_MODEL=qwen/qwen3-235b-a22b
KRONARA_KIMI_BASE_URL=https://openrouter.ai/api/v1
KRONARA_KIMI_API_KEY=
KRONARA_KIMI_MODEL=moonshotai/kimi-k2
KRONARA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KRONARA_OPENROUTER_API_KEY=
KRONARA_OPENROUTER_MODEL=
KRONARA_GROQ_BASE_URL=https://api.groq.com/openai/v1
KRONARA_GROQ_API_KEY=
KRONARA_GROQ_MODEL=
KRONARA_MODEL_REGISTRY=config/models/registry.v2.json
KRONARA_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b:free
KRONARA_HY3_MODEL=tencent/hy3:free
KRONARA_MODEL_HEALTH_TTL_SECONDS=300

# Embeddings and reranking. Kronara loads only local cached weights and reports
# an explicit degradation when they are not installed.
KRONARA_EMBEDDING_ALIAS=bge_m3
KRONARA_RERANKER_ALIAS=bge_reranker_v2_m3

# Reddit official access. Leave empty until the app/use case is approved.
KRONARA_REDDIT_ENABLED=false
KRONARA_REDDIT_CLIENT_ID=
KRONARA_REDDIT_CLIENT_SECRET=
KRONARA_REDDIT_USER_AGENT=windows:kronara:v0.5 (contact: configure-me)
KRONARA_REDDIT_CONTRACT_REFERENCE=

# Meta Page access
KRONARA_META_ENABLED=false
KRONARA_META_PAGE_ID=
KRONARA_META_PAGE_TOKEN=
# Required when Meta is enabled. Pin and review the Graph API version instead of
# silently inheriting a changing default, for example v25.0 when validated.
KRONARA_META_GRAPH_VERSION=

# Azure Speech
KRONARA_AZURE_SPEECH_ENABLED=false
KRONARA_AZURE_SPEECH_KEY=
KRONARA_AZURE_SPEECH_REGION=

# YouTube and TikTok are disabled until their later adapters are implemented.
KRONARA_YOUTUBE_ENABLED=false
KRONARA_YOUTUBE_API_KEY=
KRONARA_TIKTOK_ENABLED=false
KRONARA_TIKTOK_CLIENT_KEY=
KRONARA_TIKTOK_CLIENT_SECRET=
