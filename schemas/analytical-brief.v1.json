{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronara.local/schemas/analytical-brief.v1.json",
  "title": "AnalyticalBrief@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "status", "facts", "calculations", "inferences", "hypotheses", "recommendations", "citations", "confidence", "coverage", "contradictions", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "blocked"]},
    "facts": {"type": "array", "items": {"type": "string"}},
    "calculations": {"type": "array", "items": {"type": "string"}},
    "inferences": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}},
    "citations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio", "complete", "covered_subquestion_ids", "missing_subquestion_ids"],
      "properties": {
        "ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "complete": {"type": "boolean"},
        "covered_subquestion_ids": {"type": "array", "items": {"type": "string"}},
        "missing_subquestion_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
