{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronara.local/schemas/retrieval-query.v3.json",
  "title": "RetrievalQuery@3",
  "type": "object",
  "required": ["schema_version", "text", "now", "language", "scope", "allowed_rights", "allowed_relations", "graph_depth", "limit", "max_per_document"],
  "properties": {
    "schema_version": {"const": 3},
    "text": {"type": "string", "minLength": 1, "maxLength": 12000},
    "now": {"type": "integer", "minimum": 0},
    "language": {"type": ["string", "null"]},
    "scope": {"type": ["string", "null"]},
    "allowed_rights": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_relations": {"type": "array", "items": {"type": "string"}},
    "graph_depth": {"type": "integer", "minimum": 0, "maximum": 3},
    "limit": {"type": "integer", "minimum": 1, "maximum": 50},
    "max_per_document": {"type": "integer", "minimum": 1, "maximum": 10}
  },
  "additionalProperties": false
}
