{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronara.local/schemas/tool-trace-event.v1.json",
  "title": "ToolTraceEvent@1",
  "type": "object",
  "required": ["schema_version", "event_id", "run_id", "agent_id", "tool_id", "status", "started_at", "finished_at", "duration_ms", "arguments_redacted", "result_summary", "evidence_refs", "artifact_refs", "cost_usd", "retry", "fallback", "policy_findings"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "tool_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["started", "completed", "failed", "blocked"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "arguments_redacted": {"type": "object"},
    "result_summary": {"type": ["string", "null"], "maxLength": 2000},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "cost_usd": {"type": "number", "minimum": 0},
    "retry": {"type": "integer", "minimum": 0},
    "fallback": {"type": ["string", "null"]},
    "policy_findings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
