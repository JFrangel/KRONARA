{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronara.local/schemas/performance-diagnosis.v1.json",
  "title": "PerformanceDiagnosis@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "platform", "metric", "input_hash", "total_pieces", "total_starts", "overall_completion_rate", "overall_interval", "segments", "hypotheses", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["insufficient_data", "descriptive", "ready_for_experiment"]},
    "platform": {"type": "string", "minLength": 1},
    "metric": {"const": "completion_rate"},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "total_pieces": {"type": "integer", "minimum": 0},
    "total_starts": {"type": "integer", "minimum": 0},
    "overall_completion_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "overall_interval": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/interval"}]},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "interval": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false, "minItems": 2, "maxItems": 2},
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "value", "pieces", "starts", "completions", "completion_rate", "interval", "absolute_lift_vs_overall", "eligible"],
      "properties": {
        "dimension": {"enum": ["voice", "topic", "hook", "duration", "publication_time", "audience"]},
        "value": {"type": "string"},
        "pieces": {"type": "integer", "minimum": 0},
        "starts": {"type": "integer", "minimum": 0},
        "completions": {"type": "integer", "minimum": 0},
        "completion_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "interval": {"$ref": "#/$defs/interval"},
        "absolute_lift_vs_overall": {"type": "number", "minimum": -1, "maximum": 1},
        "eligible": {"type": "boolean"}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "dimension", "candidate_value", "statement", "baseline_rate", "candidate_rate", "absolute_lift", "causal_claim", "minimum_sample_per_variant", "recommended_experiment"],
      "properties": {
        "hypothesis_id": {"type": "string"},
        "dimension": {"type": "string"},
        "candidate_value": {"type": "string"},
        "statement": {"type": "string"},
        "baseline_rate": {"type": "number"},
        "candidate_rate": {"type": "number"},
        "absolute_lift": {"type": "number"},
        "causal_claim": {"const": false},
        "minimum_sample_per_variant": {"type": "integer", "minimum": 1},
        "recommended_experiment": {"type": "string"}
      }
    }
  }
}
