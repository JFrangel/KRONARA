{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronara.local/schemas/evidence-matrix.v1.json",
  "title": "EvidenceMatrix@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claims", "contradictions", "coverage", "dependent_source_groups", "source_uris", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "subquestion_id", "text", "kind", "status", "supporting_source_ids", "opposing_source_ids", "independent_source_count", "confidence"],
        "properties": {
          "claim_id": {"type": "string"},
          "subquestion_id": {"type": "string"},
          "text": {"type": "string"},
          "kind": {"enum": ["fact", "calculation", "inference", "hypothesis", "recommendation"]},
          "status": {"enum": ["supported", "weak", "contested", "opposed"]},
          "supporting_source_ids": {"type": "array", "items": {"type": "string"}},
          "opposing_source_ids": {"type": "array", "items": {"type": "string"}},
          "independent_source_count": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "contradictions": {"type": "array", "items": {"$ref": "#/$defs/contradiction"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "dependent_source_groups": {"type": "array", "items": {"type": "array", "minItems": 2, "items": {"type": "string"}}},
    "source_uris": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "supporting_source_ids", "opposing_source_ids"],
      "properties": {
        "claim_id": {"type": "string"},
        "supporting_source_ids": {"type": "array", "items": {"type": "string"}},
        "opposing_source_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio", "complete", "covered_subquestion_ids", "missing_subquestion_ids"],
      "properties": {
        "ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "complete": {"type": "boolean"},
        "covered_subquestion_ids": {"type": "array", "items": {"type": "string"}},
        "missing_subquestion_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
