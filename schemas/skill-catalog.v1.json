{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronara.local/schemas/skill-catalog.v1.json",
  "title": "SkillCatalog@1",
  "type": "object",
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": {"const": 1},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "version", "capabilities", "instruction_uri"],
        "properties": {
          "skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "version": {"type": "integer", "minimum": 1},
          "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "instruction_uri": {"type": "string", "pattern": "^kronara://"}
        }
      }
    }
  }
}
