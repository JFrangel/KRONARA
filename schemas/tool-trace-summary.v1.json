{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronara.local/schemas/tool-trace-summary.v1.json",
  "title": "ToolTraceSummary@1",
  "type": "object",
  "required": ["schema_version", "run_id", "event_count", "completed", "failed", "blocked", "cost_usd", "tool_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "event_count": {"type": "integer", "minimum": 0},
    "completed": {"type": "integer", "minimum": 0},
    "failed": {"type": "integer", "minimum": 0},
    "blocked": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "tool_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
