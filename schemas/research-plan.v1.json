{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronara.local/schemas/research-plan.v1.json",
  "title": "ResearchPlan@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "intent", "risk", "subquestions", "queries", "stopping_rule"],
  "properties": {
    "schema_version": {"const": 1},
    "question_id": {"type": "string", "minLength": 1},
    "intent": {"enum": ["factual", "comparative", "causal", "exploratory", "metric", "editorial"]},
    "risk": {"enum": ["low", "medium", "high"]},
    "subquestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subquestion_id", "question", "focus", "source_budget", "minimum_independent_sources"],
        "properties": {
          "subquestion_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 5},
          "focus": {"type": "string", "minLength": 1},
          "source_budget": {"type": "integer", "minimum": 1},
          "minimum_independent_sources": {"type": "integer", "minimum": 1}
        }
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subquestion_id", "source_types", "max_results"],
        "properties": {
          "subquestion_id": {"type": "string", "minLength": 1},
          "source_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "max_results": {"type": "integer", "minimum": 1}
        }
      }
    },
    "stopping_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_coverage", "minimum_independent_sources", "maximum_cost_usd", "maximum_queries", "stop_on_unresolved_high_risk_contradiction"],
      "properties": {
        "minimum_coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimum_independent_sources": {"type": "integer", "minimum": 1},
        "maximum_cost_usd": {"type": "number", "minimum": 0},
        "maximum_queries": {"type": "integer", "minimum": 1},
        "stop_on_unresolved_high_risk_contradiction": {"type": "boolean"}
      }
    }
  }
}
