{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronara.local/schemas/error-memory.v1.json",
  "title": "ErrorMemory@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["error_id", "taxonomy", "task_type", "signature", "evidence_uri", "occurred_at", "resolved_by_version"],
  "properties": {
    "error_id": {"type": "string", "minLength": 1},
    "taxonomy": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1},
    "evidence_uri": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "resolved_by_version": {"type": ["string", "null"]}
  }
}
