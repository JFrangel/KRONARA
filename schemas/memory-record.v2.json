{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronara.local/schemas/memory-record.v2.json",
  "title": "MemoryRecord@2",
  "type": "object",
  "required": ["schema_version", "record_id", "kind", "scope", "content", "provenance_uri", "confidence", "rights_mode", "valid_from", "valid_until", "version", "evidence_refs", "status"],
  "properties": {
    "schema_version": {"const": 2},
    "record_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["execution", "episodic", "semantic", "performance", "conversation", "error"]},
    "scope": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1, "maxLength": 50000},
    "provenance_uri": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rights_mode": {"type": "string", "minLength": 1},
    "valid_from": {"type": "integer", "minimum": 0},
    "valid_until": {"type": ["integer", "null"], "minimum": 0},
    "version": {"type": "integer", "minimum": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
