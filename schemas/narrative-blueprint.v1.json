{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kronara://schemas/narrative-blueprint.v1.json",
  "title": "NarrativeBlueprint@1",
  "type": "object",
  "required": ["schema", "target_duration_seconds", "stages"],
  "properties": {
    "schema": { "const": "NarrativeBlueprint@1" },
    "target_duration_seconds": { "type": "integer", "minimum": 30 },
    "stages": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["position", "name", "target_seconds", "purpose"],
        "properties": {
          "position": { "type": "integer", "minimum": 1, "maximum": 10 },
          "name": { "type": "string", "minLength": 1 },
          "target_seconds": { "type": "integer", "minimum": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

